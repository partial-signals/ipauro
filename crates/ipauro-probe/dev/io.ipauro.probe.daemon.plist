<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  R002-T8 probe: root LaunchDaemon context.

  Runs `ipauro-probe check` out-of-session, as root, at load. Apple's docs
  suggest out-of-session daemons MAY be exempt from the macOS 15+ Local
  Network privacy gate -- this plist exists to verify that empirically rather
  than trust the docs (see RUNBOOK.md).

  BEFORE installing:
    1. Build the binary: cargo build --release -p ipauro-probe
    2. Replace __IPAURO_PROBE_BIN__ below with the absolute path to it
       (e.g. /Users/you/ipauro/target/release/ipauro-probe).
    3. Install per RUNBOOK.md's "root LaunchDaemon" section.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.ipauro.probe.daemon</string>

	<key>ProgramArguments</key>
	<array>
		<string>__IPAURO_PROBE_BIN__</string>
		<string>check</string>
		<string>--seconds</string>
		<string>10</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/tmp/ipauro-probe-daemon.log</string>

	<key>StandardErrorPath</key>
	<string>/tmp/ipauro-probe-daemon.err.log</string>
</dict>
</plist>
